# PostgreSQL local (docker compose + perfil dev de la app)
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Datasource del perfil dev
DB_URL=jdbc:postgresql://localhost:5432/todo
DB_USERNAME=todo
DB_PASSWORD=change-me

# JWT (Fase 1) - minimo 32 bytes para HS256
JWT_SECRET=change-me-to-a-long-random-secret-value-at-least-32-bytes

# OAuth2 Google (Fase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (Fase 4)
RESEND_API_KEY=
MAIL_FROM=no-reply@example.com
