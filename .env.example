# Copia este archivo a .env y rellena lo que necesites.
# No hace falta exportar nada: docker compose y el perfil dev de la app cargan .env automaticamente.

# PostgreSQL local (docker compose + perfil dev de la app)
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_PORT=5432

# Datasource del perfil dev
DB_URL=jdbc:postgresql://localhost:5432/todo
DB_USERNAME=todo
DB_PASSWORD=todo

# JWT (Fase 1) - minimo 32 bytes para HS256
JWT_SECRET=change-me-to-a-long-random-secret-value-at-least-32-bytes

# OAuth2 Google (Fase 1) - descomenta y rellena para probar el login con Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback

# Resend (Fase 4) - descomenta y rellena para enviar correos reales; sin API key se registran en logs
# RESEND_API_KEY=
MAIL_FROM=no-reply@example.com
INVITATION_ACCEPT_URL=http://localhost:3000/invitations/accept
INVITATION_REJECT_URL=http://localhost:3000/invitations/reject
